# Copy this file to .env and replace the example password before starting Compose.
POSTGRES_USER=corporation_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=corporation_db
POSTGRES_PORT=5432
BACKEND_PORT=8000

# Use the Compose service name (`db`) when the backend runs in Docker.
DATABASE_URL=postgresql://corporation_user:change_me@db:5432/corporation_db

# Development placeholder only. Replace with a long random value outside development.
JWT_SECRET_KEY=development-only-change-before-production
